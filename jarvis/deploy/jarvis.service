[Unit]
Description=Jarvis workshop galaxy + Flightdeck tools
After=network.target flightdeck.service
Wants=flightdeck.service

[Service]
Type=simple
User=flightdeck
Group=flightdeck
WorkingDirectory=/home/flightdeck/flightdeck/jarvis
ExecStartPre=/usr/bin/python3 /home/flightdeck/flightdeck/jarvis/build.py
ExecStart=/usr/bin/python3 /home/flightdeck/flightdeck/jarvis/server.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
