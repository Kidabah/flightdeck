# Copy to .env beside docker-compose.nas.yml before starting the NAS stack.
TZ=Australia/Sydney

# OrcaSlicer Docker web UI basic auth.
ORCASLICER_USER=flightdeck
ORCASLICER_PASSWORD=change-me-before-use
ORCASLICER_PUID=1000
ORCASLICER_PGID=1000

# Bambu Studio Docker web UI basic auth.
BAMBUSTUDIO_USER=flightdeck
